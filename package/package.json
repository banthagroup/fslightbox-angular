{
  "name": "fslightbox-angular",
  "version": "0.5.0",
  "description": "A capable Angular component for displaying images, videos, or, through custom sources, anything you want in a full-window overlying box.",
  "module": "index.mjs",
  "typings": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./16-19": {
      "types": "./index.d.ts",
      "default": "./16-19.mjs"
    }
  },
  "typesVersions": {
     "*": {
        "*": ["./index.d.ts"]
     }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/banthagroup/fslightbox-angular"
  },
  "keywords": [
    "angular fslightbox",
    "angular lightbox",
    "angular slide gallery",
    "angular modal",
    "fslightbox angular"
  ],
  "author": "Piotr Zdziarski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/banthagroup/fslightbox-angular/issues"
  },
  "homepage": "https://fslightbox.com/angular",
  "peerDependencies": {
    "@angular/common": ">=16.0.0",
    "@angular/core": ">=16.0.0"
  }
}
